{
  "version": 7,
  "tables": {
    "sources": {
      "path": "corpus/sources.tsv",
      "key": "source_id",
      "required_columns": [
        "source_id",
        "source_type",
        "archive",
        "fonds",
        "signature",
        "record_id",
        "title",
        "date_from",
        "date_to",
        "date_calendar_label",
        "date_serial_from",
        "date_serial_to",
        "folios",
        "digital_url"
      ],
      "required_nonempty": [
        "source_id",
        "source_type",
        "archive",
        "fonds",
        "signature",
        "title"
      ]
    },
    "relationships": {
      "path": "corpus/relationships.tsv",
      "key": "relation_id",
      "required_columns": [
        "relation_id",
        "subject_id",
        "subject_locus",
        "predicate",
        "object_id",
        "object_locus",
        "status",
        "evidence_basis",
        "notes"
      ],
      "required_nonempty": [
        "relation_id",
        "subject_id",
        "predicate",
        "object_id",
        "status",
        "evidence_basis"
      ]
    },
    "files": {
      "path": "corpus/files.tsv",
      "key": "file_id",
      "required_columns": [
        "file_id",
        "source_id",
        "filename",
        "sha256",
        "role",
        "coverage",
        "storage_status",
        "rights_status"
      ],
      "required_nonempty": [
        "file_id",
        "source_id",
        "filename",
        "sha256",
        "role",
        "coverage",
        "storage_status",
        "rights_status"
      ]
    },
    "projects": {
      "glob": "projects/*/project.yml",
      "required_keys": [
        "id",
        "project_source_id",
        "source_register",
        "canonical_status_file"
      ]
    },
    "project_sources": {
      "glob": "projects/*/sources/sources.tsv",
      "required_columns": [
        "source_id",
        "archival_title",
        "project_role",
        "relevant_locus",
        "primary_file_id",
        "status"
      ],
      "required_nonempty": [
        "source_id",
        "archival_title",
        "project_role",
        "status"
      ]
    },
    "project_source_uses": {
      "glob": "projects/*/source-uses.tsv",
      "required_columns": [
        "use_id",
        "source_id",
        "research_function",
        "relevant_locus",
        "status",
        "evidence_basis",
        "notes"
      ],
      "required_nonempty": [
        "use_id",
        "source_id",
        "research_function",
        "status",
        "evidence_basis"
      ]
    },
    "project_use_evidence": {
      "glob": "projects/*/research/use-evidence.tsv",
      "required_columns": [
        "evidence_id",
        "use_id",
        "file_id",
        "evidence_locator",
        "status",
        "evidence_basis",
        "notes"
      ],
      "required_nonempty": [
        "evidence_id",
        "use_id",
        "file_id",
        "status",
        "evidence_basis"
      ]
    },
    "crosswalks": {
      "glob": "corpus/source-data/*/crosswalk.tsv",
      "required_columns": [
        "source_id",
        "archival_folio",
        "mapping_status"
      ],
      "locator_fields": [
        "export_image",
        "pdf_page",
        "stable_image_urn"
      ]
    }
  },
  "controlled_values": {
    "files.storage_status": [
      "repo-preserved",
      "external-controlled",
      "preservation-blocked-public-redistribution"
    ],
    "crosswalk.mapping_status": [
      "observed",
      "inferred-high",
      "unresolved",
      "working"
    ]
  }
}
